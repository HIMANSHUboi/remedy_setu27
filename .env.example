# =============================================================================
# Remedy Setu — Environment Configuration
# Copy this file to .env and populate any optional connectors you wish to enable.
# The app runs out of the box with zero external API keys using Demo Auth,
# owner-scoped memory persistence, and the deterministic multilingual NLP engine.
# =============================================================================

# --- Supabase Connector (Client + SSR) ---
SUPABASE_PROJECT_ID="uhxjrjdajmjilhshvdbz"
SUPABASE_URL="https://uhxjrjdajmjilhshvdbz.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_oZdNs7uL3QGn8OXCaM2-Mg_mOm_NShJ"
VITE_SUPABASE_PROJECT_ID="uhxjrjdajmjilhshvdbz"
VITE_SUPABASE_URL="https://uhxjrjdajmjilhshvdbz.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_oZdNs7uL3QGn8OXCaM2-Mg_mOm_NShJ"

# Optional server-only Supabase Service Role key (for admin/demo persistence)
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional PostgreSQL connection string for Drizzle Kit migrations
# DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# --- AI Inference Connectors (Optional — pick any one; falls back deterministically) ---
# Google Gemini (defaults to gemini-2.5-flash)
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"

# Groq (defaults to llama-3.3-70b-versatile)
# GROQ_API_KEY=""

# OpenAI or OpenAI-compatible endpoint (defaults to gpt-4o-mini)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"

# Anthropic Claude (defaults to claude-3-5-haiku-latest)
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# --- WhatsApp Business Cloud API Connector (Optional — defaults to wa.me deep link) ---
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN="remedy_setu_verify"

# --- Scheduled Cron Connector (Optional) ---
# CRON_SECRET=""
# CRON_SECRET_PREVIOUS=""
